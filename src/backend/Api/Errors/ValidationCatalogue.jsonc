    "en": "The link token is required.",
    "usedIn": "AcceptStaffInviteRequest, AcceptSupplierUserInviteRequest, ResetPasswordRequest",
    "flag": "Not a field the user types - it arrives in the invite/reset link. Wording assumes the message is only ever seen when a link is malformed."
  },
