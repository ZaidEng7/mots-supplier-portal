<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\MotsSupplierPortal.Domain.csproj" />
    <ProjectReference Include="..\Application\MotsSupplierPortal.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.20" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.12" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <!-- FEAT-19.4 export engine. SkiaSharp draws and emits the PDF (SKDocument.CreatePdf);
         HarfBuzzSharp shapes Arabic. Both MIT. The NativeAssets.Linux packages are NOT optional:
         the main packages carry macOS and Windows natives only, and this API ships in a Linux
         container - a PDF endpoint that works on a developer's machine and throws DllNotFound in
         production is the failure this line exists to prevent. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>


  <!-- Both faces are EMBEDDED, not resolved from the host. A PDF that renders on a machine with
       Arabic system fonts and shows .notdef boxes on a reviewer's is not a working export, and the
       container this ships in has no fonts installed at all. Licensing: SIL Open Font License 1.1,
       which permits embedding; OFL.txt ships beside them. -->
  <ItemGroup>
    <EmbeddedResource Include="Reporting/Fonts/NotoNaskhArabic-Regular.ttf" />
    <EmbeddedResource Include="Reporting/Fonts/NotoSans-Regular.ttf" />
  </ItemGroup>

</Project>
